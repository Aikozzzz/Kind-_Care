# KindCare Docker Compose overrides
# Copy to .env only when changing a default. These values are for a local demo.

# Demo credentials. Replace both passwords before sharing a development machine.
# Compose interpolates RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS directly into
# AMQP URLs. Both must use only URI-unreserved [A-Za-z0-9._~-]+ characters; raw URI
# reserved characters, percent escapes, whitespace, and empty values are unsupported.
RABBITMQ_DEFAULT_USER=kindcare
RABBITMQ_DEFAULT_PASS=kindcare_dev_only
MQTT_USERNAME=kindcare_mqtt
MQTT_PASSWORD=kindcare_mqtt_dev_only

# Backend readiness, dashboard summaries, and browser/WebSocket behavior.
READINESS_TIMEOUT_SECONDS=2.0
DASHBOARD_RECENT_ALERT_LIMIT=10
DASHBOARD_UPCOMING_REMINDER_LIMIT=10
DASHBOARD_RECENT_REMINDER_LIMIT=10
WEBSOCKET_POLL_INTERVAL=1.0
WEBSOCKET_HEARTBEAT_INTERVAL=15.0
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
WEBSOCKET_AUTH_REQUIRED=true
DASHBOARD_REFRESH_SECONDS=5.0
DEFAULT_ELDERLY_ID=E001

# Account security and optional Telegram integration. Keep secrets empty until configured.
AUTH_SESSION_SECONDS=3600
AUTH_BOOTSTRAP_SECRET=
TELEMETRY_SERVICE_TOKEN=kindcare_telemetry_dev_only
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_SERVICE_TOKEN=
TELEGRAM_HTTP_TIMEOUT=10
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_RETRY_SECONDS=5
TELEGRAM_DELIVERY_LEASE_SECONDS=60

# Browser/host URL: PUBLIC_WS_BASE_URL must be reachable by the caregiver browser.
PUBLIC_WS_BASE_URL=ws://localhost:8000

# Internal service URL: API_BASE_URL is resolved inside the Compose network.
# Do not replace it with localhost for the containerized dashboard.
API_BASE_URL=http://backend:8000

# Detection thresholds, scanner cadence/bounds, leases, and worker health.
ACTIVITY_INACTIVITY_SECONDS=3600
ACTIVITY_SCAN_SECONDS=30
ACTIVITY_SCAN_BATCH_SIZE=100
DEVICE_OFFLINE_SECONDS=120
DEVICE_OFFLINE_SCAN_SECONDS=30
DEVICE_SCAN_BATCH_SIZE=100
REMINDER_GRACE_SECONDS=300
REMINDER_SCAN_SECONDS=30
REMINDER_SCAN_BATCH_SIZE=100
SCAN_LEASE_SECONDS=60
SERVICE_HEARTBEAT_SECONDS=15
SERVICE_HEARTBEAT_MAX_AGE_SECONDS=60

# MQTT ingestor bounds and retry policy. Broker/API container addresses are internal
# fixed Compose values; host MQTT clients use mqtt://127.0.0.1:1883.
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_QUEUE_SIZE=100
MQTT_HTTP_TIMEOUT=10
MQTT_RETRY_INITIAL_SECONDS=0.5
MQTT_RETRY_MAX_SECONDS=30
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_HEALTH_MAX_AGE_SECONDS=15
