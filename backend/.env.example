# Backend-only direct-run settings. Docker Compose injects internal service URLs and
# reads user-overridable Compose values from the root .env file instead.
APP_NAME=KindCare API

# Host/direct-run URLs. From a container these hosts are mongodb and rabbitmq, not
# localhost. RabbitMQ's guest account is intentionally not used.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
DATABASE_NAME=kindcare_db
RABBITMQ_URL=amqp://kindcare:replace_this_local_password@localhost:5672//

READINESS_TIMEOUT_SECONDS=2.0
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
DASHBOARD_RECENT_ALERT_LIMIT=10
DASHBOARD_UPCOMING_REMINDER_LIMIT=10
DASHBOARD_RECENT_REMINDER_LIMIT=10
WEBSOCKET_POLL_INTERVAL=1.0
WEBSOCKET_HEARTBEAT_INTERVAL=15.0
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ACTIVITY_INACTIVITY_SECONDS=3600
DEVICE_OFFLINE_SECONDS=120
DEVICE_OFFLINE_SCAN_SECONDS=30
